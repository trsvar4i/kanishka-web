---
// Vector redraw of the narrow KANIШKA wordmark retained in brand-logo.jpg.
interface Props {class?:string;label?:string;decorative?:boolean}
const {class:className,label='Kanishka',decorative=false}=Astro.props;
---
<svg class:list={['brand-mark',className]} viewBox="0 0 240 48" fill="none" xmlns="http://www.w3.org/2000/svg" role={decorative?undefined:'img'} aria-label={decorative?undefined:label} aria-hidden={decorative?'true':undefined}>
  <g stroke="currentColor" stroke-width="1.65" stroke-linecap="square" stroke-linejoin="miter">
    <path d="M3 3V45M24 3L3 24L25 45"/>
    <path d="M38 45L49 3L60 45M42.3 29H55.7"/>
    <path d="M75 45V3L96 45V3"/>
    <path d="M113 3V45"/>
    <path d="M131 3V45H157V3M144 3V45"/>
    <path d="M174 3V45M195 3L174 24L196 45"/>
    <path d="M209 45L220 3L231 45M213.3 29H226.7"/>
  </g>
</svg>
