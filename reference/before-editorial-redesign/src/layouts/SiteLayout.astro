---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {languages,type Lang} from '../lib/types';
import {pathFor} from '../lib/i18n';
import '../styles.css';
import '../styles/site.css';
interface Props {lang:Lang;title:string;description:string;route?:string;page?:string;image?:string;productId?:string}
const {lang,title,description,route='',page='home',image='/assets/images/latest-21.jpg',productId}=Astro.props;
const absolute=(path:string)=>Astro.site?new URL(path,Astro.site).href:path;
---
<!doctype html>
<html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#222220"/><title>{title}</title><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={page==='product'?'product':'website'}/><meta property="og:image" content={absolute(image)}/><meta property="og:url" content={absolute(pathFor(lang,route))}/><link rel="canonical" href={absolute(pathFor(lang,route))}/>{languages.map(locale=><link rel="alternate" hreflang={locale} href={absolute(pathFor(locale,route))}/>)}<link rel="alternate" hreflang="x-default" href={absolute(pathFor('ru',route))}/><link rel="icon" href="/assets/images/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&display=swap" rel="stylesheet"/><link rel="preload" as="image" href={image}/></head>
<body data-page={page} data-product-id={productId}><Header lang={lang} route={route} page={page}/><main id="main"><slot/></main><Footer lang={lang}/><script>import '../scripts/site';</script></body></html>
