---
import CatalogPage from '../../components/CatalogPage.astro';
import {secondaryLanguages} from '../../lib/i18n';
import type {Lang} from '../../lib/types';
export function getStaticPaths(){return secondaryLanguages.map(lang=>({params:{lang},props:{lang}}));}
interface Props {lang:Lang}
const {lang}=Astro.props;
---
<CatalogPage lang={lang}/>
